    programa {
  funcao inicio() {
    inteiro n1, n2, n3, mid

    escreva("digite a primeira nota: ")
    leia(n1)
    escreva("digite a segunda nota: ")
    leia(n2)
    escreva("digite sua terceira nota: ")
    leia(n3)
   
    mid = (n1 + n2 + n3)/3

   escreva("a area do retangulo é: ", mid)
  }
}